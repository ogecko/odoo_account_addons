#!/usr/bin/env bash
# Blocks business data from being committed: private paths, data and archive
# files, large files, names listed in .private-terms (git-ignored, one
# case-insensitive regex per line) and real amounts from data/examples/*.ofx.
# Enable once per clone: git config core.hooksPath .githooks
set -u
root=$(git rev-parse --show-toplevel)
fail=0
err() { echo "pre-commit: $*" >&2; fail=1; }

while IFS= read -r -d '' f; do
    git check-ignore -q --no-index -- "$f" && err "$f: path is git-ignored (private)"
    case "$f" in
        *.dump|*.ofx|*.tar|*.tgz|*.gz|*.sql|*.zip|*:Zone.Identifier) err "$f: data or archive file type" ;;
    esac
    [ "$(git cat-file -s ":$f")" -gt 1048576 ] && err "$f: larger than 1 MB"
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

added=$(git diff --cached -U0 --diff-filter=ACMR --no-color --no-ext-diff | grep '^+' | grep -v '^+++')

if [ -f "$root/.private-terms" ]; then
    while IFS= read -r term; do
        case "$term" in ''|'#'*) continue ;; esac
        printf '%s\n' "$added" | grep -qiE -- "$term" && err "private term matched: $term"
    done < "$root/.private-terms"
fi

# Amounts under 10.00 are too common to mean anything.
for amount in $(cat "$root"/data/examples/*.ofx 2>/dev/null | grep -oE '<TRNAMT>-?[0-9]+\.[0-9]{2}' \
        | sed -E 's/<TRNAMT>-?//' | awk '$1 >= 10' | sort -u); do
    printf '%s\n' "$added" | grep -qE "(^|[^0-9.])${amount//./\\.}([^0-9]|$)" \
        && err "amount $amount appears in data/examples (real bank data)"
done

[ $fail -eq 0 ] || echo "pre-commit: commit blocked. Remove the data above (or fix .private-terms if it is a false match)." >&2
exit $fail
