<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Saved export list whose CSV imports back as Bank Statement Templates:
         in Export, tick "Import-Compatible Export" and pick this list. That adds
         an id column, so a re-import updates the templates it came from
         instead of adding copies (their split lines are replaced by the
         file's). Linked records are written by name (see txn_template.py). -->
    <record id="txn_template_export" model="ir.exports">
        <field name="name">Bank Statement Templates (import)</field>
        <field name="resource">account.bank.txn.template</field>
        <field name="export_fields" eval="[(5, 0, 0),
                (0, 0, {'name': 'name'}),
                (0, 0, {'name': 'active'}),
                (0, 0, {'name': 'sequence'}),
                (0, 0, {'name': 'kind'}),
                (0, 0, {'name': 'journal_id'}),
                (0, 0, {'name': 'direction'}),
                (0, 0, {'name': 'match_text'}),
                (0, 0, {'name': 'match_is_regex'}),
                (0, 0, {'name': 'amount_min'}),
                (0, 0, {'name': 'amount_max'}),
                (0, 0, {'name': 'account_id'}),
                (0, 0, {'name': 'partner_id'}),
                (0, 0, {'name': 'product_id'}),
                (0, 0, {'name': 'tax_ids/id'}),
                (0, 0, {'name': 'description'}),
                (0, 0, {'name': 'companion_text'}),
                (0, 0, {'name': 'companion_is_regex'}),
                (0, 0, {'name': 'companion_product_id'}),
                (0, 0, {'name': 'companion_tax_ids/id'}),
                (0, 0, {'name': 'companion_description'}),
                (0, 0, {'name': 'fee_pct_min'}),
                (0, 0, {'name': 'fee_pct_max'}),
                (0, 0, {'name': 'franked_pct'}),
                (0, 0, {'name': 'company_tax_rate'}),
                (0, 0, {'name': 'div_franked_account_id'}),
                (0, 0, {'name': 'div_unfranked_account_id'}),
                (0, 0, {'name': 'franking_income_account_id'}),
                (0, 0, {'name': 'franking_credit_account_id'}),
                (0, 0, {'name': 'split_ids/sequence'}),
                (0, 0, {'name': 'split_ids/keyword'}),
                (0, 0, {'name': 'split_ids/account_id'}),
                (0, 0, {'name': 'split_ids/description'}),
            ]"/>
    </record>
</odoo>
