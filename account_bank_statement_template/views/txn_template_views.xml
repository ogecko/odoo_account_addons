<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_txn_template_tree" model="ir.ui.view">
        <field name="name">account.bank.txn.template.tree</field>
        <field name="model">account.bank.txn.template</field>
        <field name="arch" type="xml">
            <tree string="Bank Statement Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="direction"/>
                <field name="match_text"/>
                <field name="amount_min"/>
                <field name="amount_max"/>
                <field name="partner_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_bank_txn_template_form" model="ir.ui.view">
        <field name="name">account.bank.txn.template.form</field>
        <field name="model">account.bank.txn.template</field>
        <field name="arch" type="xml">
            <form string="Bank Statement Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. AWS"/></h1>
                    </div>
                    <group>
                        <group string="Match">
                            <field name="kind"/>
                            <field name="direction"/>
                            <field name="match_text"/>
                            <field name="match_is_regex"/>
                            <field name="amount_min"/>
                            <field name="amount_max"/>
                            <field name="journal_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Creates">
                            <field name="partner_id" attrs="{'invisible': [('kind', 'in', ['direct', 'split', 'dividend'])]}"/>
                            <field name="product_id" attrs="{'invisible': [('kind', 'in', ['direct', 'split', 'dividend'])]}"/>
                            <field name="account_id" attrs="{'invisible': [('kind', '!=', 'direct')]}"/>
                            <field name="tax_ids" widget="many2many_tags" attrs="{'invisible': [('kind', 'in', ['direct', 'split', 'dividend'])]}"/>
                            <field name="description" attrs="{'invisible': [('kind', '=', 'split')]}"/>
                            <div colspan="2" class="text-muted">
                                Keywords:
                                <code>{year}</code>
                                <code>{first_week}</code>
                                <code>{last_week}</code>
                                <code>{quarter}</code>
                                <code>{date}</code>
                                <code>{period_end}</code>
                                <code>{prior_period_end}</code>
                                Example: <code>Services {year} (Wk{first_week} to Wk{last_week})</code>
                            </div>
                        </group>
                    </group>
                    <group string="Dividend" attrs="{'invisible': [('kind', '!=', 'dividend')]}">
                        <group>
                            <field name="franked_pct"/>
                            <field name="company_tax_rate"/>
                            <div colspan="2" class="text-muted" style="padding-right: 16px;">
                                Bank amount = franked + unfranked<br/>
                                Franking credit = franked / (1 - tax rate) - franked<br/>
                                Credit income, debit tax credit.<br/>
                                Description prefixes each line, e.g. <code>WDS 100 Div</code>
                            </div>
                        </group>
                        <group>
                            <field name="div_franked_account_id" attrs="{'required': [('kind', '=', 'dividend')]}"/>
                            <field name="div_unfranked_account_id" attrs="{'required': [('kind', '=', 'dividend')]}"/>
                            <field name="franking_income_account_id" attrs="{'required': [('kind', '=', 'dividend')]}"/>
                            <field name="franking_credit_account_id" attrs="{'required': [('kind', '=', 'dividend')]}"/>
                        </group>
                    </group>
                    <separator string="Split" attrs="{'invisible': [('kind', '!=', 'split')]}"/>
                    <div class="text-muted" attrs="{'invisible': [('kind', '!=', 'split')]}">
                        Each line's amount is the number after its keyword in the bank description
                        (e.g. <code>GST 12 PAYG 300</code>); 0 if it isn't there. Lines left at 0 aren't posted.
                    </div>
                    <field name="split_ids" attrs="{'invisible': [('kind', '!=', 'split')]}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="keyword"/>
                            <field name="account_id"/>
                            <field name="description"/>
                        </tree>
                    </field>
                    <group string="Fee" attrs="{'invisible': [('kind', 'not in', ['sale_order', 'purchase_order'])]}">
                        <group>
                            <field name="companion_text"/>
                            <field name="companion_is_regex"/>
                            <field name="fee_pct_min"/>
                            <field name="fee_pct_max"/>
                        </group>
                        <group>
                            <field name="companion_product_id"/>
                            <field name="companion_description"/>
                            <field name="companion_tax_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_txn_template" model="ir.actions.act_window">
        <field name="name">Bank Statement Templates</field>
        <field name="res_model">account.bank.txn.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_bank_txn_template" action="action_bank_txn_template"
              parent="account.menu_finance_configuration" sequence="40"
              groups="account.group_account_manager"/>

</odoo>
